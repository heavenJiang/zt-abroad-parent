# 生产 / 测试环境配置：复制为 .env 后填写（.env 不进仓库）
# 生成随机串：openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# 域名（需备案；HTTPS 证书见 README）
ADMIN_DOMAIN=admin.example.com
APP_DOMAIN=m.example.com
WWW_DOMAIN=www.example.com
API_DOMAIN=api.example.com

# 数据库
POSTGRES_USER=abroad
POSTGRES_PASSWORD=请改为随机强密码
POSTGRES_DB=abroad

# Redis
REDIS_PASSWORD=请改为随机强密码

# 员工令牌密钥（至少 32 位随机串，更换后所有员工需重新登录）
TOKEN_SECRET=请改为随机强密钥

# 备份：保留天数、每天执行的时刻（北京时间，HH:MM）
BACKUP_KEEP_DAYS=30
BACKUP_AT=03:30

# 镜像标签（deploy.sh 构建时写入，一般不用改）
IMAGE_TAG=latest

# 宿主机端口（一般保持 80 / 443）
HTTP_PORT=80
HTTPS_PORT=443
