{
  "type": "object",
  "required": ["headline", "programs", "shortcomings"],
  "additionalProperties": false,
  "properties": {
    "headline": { "type": "string", "minLength": 4, "maxLength": 120 },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["programId", "reason"],
        "additionalProperties": false,
        "properties": {
          "programId": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 2, "maxLength": 200 }
        }
      }
    },
    "shortcomings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "text"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 9 },
          "text": { "type": "string", "minLength": 2, "maxLength": 200 }
        }
      }
    }
  }
}
